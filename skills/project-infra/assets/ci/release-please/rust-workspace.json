{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "version-file": ".release-please-version",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "crates/example-cli/Cargo.toml",
          "jsonpath": "$.dependencies.example-core.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"example-core\")].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"example-cli\")].version"
        },
        {
          "type": "toml",
          "path": "fuzz/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"example-core\")].version"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    }
  }
}
